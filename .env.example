# Fireside local configuration
#
# Copy to `.env` for local overrides. Values already present in the shell
# environment take precedence over this file.

# HTTP server
FIRESIDE_HOST=127.0.0.1
FIRESIDE_PORT=8787

# Runtime database, logs, conversation fixtures, draft artifacts, and CLI session metadata.
# Keep this out of git.
FIRESIDE_DATA_DIR=./data

# Static UI directory. Leave blank to use the built Angular bundle in `dist/client/browser`
# when present, otherwise the legacy `ui/` fallback.
# FIRESIDE_UI_DIR=./dist/client/browser

# Prompt shaping
FIRESIDE_MAX_PROMPT_CHARS=16000
FIRESIDE_LARGE_MESSAGE_CHARS=6000

# Keep Claude/Codex/Gemini CLI sessions resumable across turns.
FIRESIDE_RESUME_CLI_SESSIONS=true

# Gemini CLI defaults. Fireside passes this explicitly so the CLI does not
# fall back to a lower-tier/default Flash model.
FIRESIDE_GEMINI_MODEL=gemini-3.1-pro-preview

# Optional extra trusted roots for Gemini YOLO/include-directories access.
# Semicolon- or comma-separated.
FIRESIDE_GEMINI_UNRESTRICTED_ROOTS=

# Automatic context maintenance. Per-agent UI settings control the normal
# percentage threshold; these envs are fallback/defaults plus a global kill
# switch for resumable-session compaction.
FIRESIDE_AUTO_COMPACT_ENABLED=true
FIRESIDE_AUTO_COMPACT_PERCENT=70
FIRESIDE_AUTO_COMPACT_TOKEN_LIMIT=220000

# Optional Codex context telemetry overrides. If unset, Fireside reads
# CODEX_HOME/config.toml or falls back to known model defaults where possible.
# FIRESIDE_CODEX_MODEL=gpt-5.5
# FIRESIDE_CODEX_REASONING_EFFORT=xhigh
# FIRESIDE_CODEX_CONTEXT_WINDOW=400000
# FIRESIDE_CODEX_AUTO_COMPACT_TOKENS=320000

# MCP endpoint (POST /api/mcp). Off by default. When enabled, same-host
# (loopback) callers reach the structured tool engine with no auth header.
# Non-loopback callers MUST present `Authorization: Bearer <FIRESIDE_MCP_API_KEY>`;
# if the key is unset, every non-loopback request is rejected with 403.
# Generate the key yourself (e.g. `openssl rand -hex 32`) and treat it as a
# shared secret. There is no rotation or multi-key support — this is the
# single-tenant local-first trust model.
# FIRESIDE_ENABLE_MCP=1
# FIRESIDE_MCP_API_KEY=

# Server logging: trace, debug, info, warn, error, fatal, or silent.
LOG_LEVEL=info
